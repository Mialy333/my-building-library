---
// A project's live demo, shown as a poster: its illustrated intro (the demo's own
// social-preview image), a label, a title, one sentence, and the links.
// Used on the book page ("To try") and at the top of the chapter the demo belongs to.
import { Image } from "astro:assets";
import { getLocale, useTranslations } from "../i18n/ui";
import { type Book, type Chapter, chapterUrl, chapterLabel } from "../data/books";

interface Props {
  book: Book;
  chapter: Chapter;
  // On the book page the card also leads to the chapter; on the chapter page it doesn't.
  withChapterLink?: boolean;
}

const { book, chapter, withChapterLink = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const showcase = chapter.showcase;
---

{showcase && chapter.demo && (
  <figure class="demo">
    <a class="shot" href={chapter.demo} target="_blank" rel="noopener" aria-label={`${t("demo.open")} : ${showcase.title}`}>
      <Image
        src={showcase.image}
        alt={showcase.alt[locale]}
        widths={[600, 900, 1200]}
        sizes="(min-width: 720px) 672px, calc(100vw - 48px)"
      />
    </a>
    <figcaption>
      <span class="label">{t("demo.label")} · {chapterLabel(chapter, t)}</span>
      <span class="title">{showcase.title}</span>
      <span class="text">{showcase.text[locale]}</span>
      <span class="links">
        <a href={chapter.demo} target="_blank" rel="noopener">{t("demo.open")} ↗</a>
        {withChapterLink && <a href={chapterUrl(locale, book, chapter)}>{t("book.read")}</a>}
      </span>
    </figcaption>
  </figure>
)}

<style>
  /* A poster pinned to the page: ink border and solid offset shadow, like the covers. */
  .demo { margin: 0; }
  .shot {
    display: block; overflow: hidden; border: 1px solid var(--ink); border-radius: 14px;
    box-shadow: 5px 5px 0 var(--shadow); transition: transform .25s ease, box-shadow .25s ease;
  }
  .shot img { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; }
  .shot:hover, .shot:focus-visible { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--shadow); }
  figcaption { display: flex; flex-direction: column; gap: 6px; margin-top: 16px; }
  .label {
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 2px; text-transform: uppercase; color: var(--ink-muted);
  }
  .title { font-family: var(--font-serif); font-size: 26px; line-height: 1.1; color: var(--ink); }
  .text { font-family: var(--font-reading); font-size: 17px; line-height: 1.55; color: var(--ink-soft); }
  .links { display: flex; flex-wrap: wrap; column-gap: 24px; }
  .links a { display: inline-flex; align-items: center; min-height: 44px; font-size: 16px; font-weight: 600; text-underline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .shot { transition: none; }
    .shot:hover, .shot:focus-visible { transform: none; }
  }
</style>
