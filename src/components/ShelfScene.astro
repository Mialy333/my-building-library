---
// Illustrated band at the top of the shelf page: a reading nook under an arched
// window, between two bookcases, with a sleeping cat on the window seat.
// Same recipe as the home scene: pure SVG + CSS, no JavaScript, day/night follows
// the site theme, and everything stops with prefers-reduced-motion.
// Futuristic touches: a sky-tram crossing the city, a floating holographic book.
import { getLocale, useTranslations } from "../i18n/ui";

const t = useTranslations(getLocale(Astro.currentLocale));
---

<div class="shelf-scene" role="img" aria-label={t("shelf.sceneLabel")}>
<svg viewBox="0 0 720 300" preserveAspectRatio="xMidYMid slice" class="art" aria-hidden="true">
 <defs>
  <linearGradient id="sh-skyD" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F3C4A6"/><stop offset="1" stop-color="#E8A7B6"/></linearGradient>
  <linearGradient id="sh-skyN" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1C1424"/><stop offset="1" stop-color="#4A2E4F"/></linearGradient>
  <linearGradient id="sh-beam" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFF3EA" stop-opacity=".55"/><stop offset="1" stop-color="#FFF3EA" stop-opacity="0"/></linearGradient>
  <clipPath id="sh-archA"><path d="M276 236 V110 a84 84 0 0 1 168 0 V236 Z"/></clipPath>
  <radialGradient id="sh-glow"><stop offset="0" stop-color="#FFD98A" stop-opacity=".55"/><stop offset="1" stop-color="#FFD98A" stop-opacity="0"/></radialGradient>
  <radialGradient id="sh-holo"><stop offset="0" stop-color="#F4B6CF" stop-opacity=".7"/><stop offset="1" stop-color="#F4B6CF" stop-opacity="0"/></radialGradient>
 </defs>
