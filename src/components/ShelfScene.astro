<style>
  /* Day palette (scene-only colours). Night palette below follows the site theme,
     with the same two selectors as the home scene. */
  .shelf-scene {
    --n: 0;
    --wall: #F6E6DC; --case: #E3C2B4; --board: #C99E8C; --floor: #EAD3C8; --skirt: #E3C2B4;
    --seat: #E3C2B4; --seat-front: #EAD3C8; --cushion: #F4DDE2;
    --b1: #8FB394; --b2: #E9A47E; --b3: #E8A7B6; --b4: #7A2E5C; --b5: #F1E6DA; --b6: #4A3F47; --band: #FBF7F3;
    --city: #D59AA8; --cloud: #FFF3EA; --orb: #FBE3B8;
    --fur: #E9B07F; --fur-line: #C98A5C; --curtain: #F4DDE2; --frame: #FBF7F3; --neon: transparent;
    --lamp: #E3C2B4; --leaf: #8FB394; --leafdk: #6F9A78;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .shelf-scene {
      --n: 1;
      --wall: #2A1E2A; --case: #3A2A35; --board: #4A3743; --floor: #2D2129; --skirt: #3A2A35;
      --seat: #3A2A35; --seat-front: #2D2129; --cushion: #7A2E5C;
      --b1: #557D5E; --b2: #A86A50; --b3: #9C5A6C; --b4: #5E2347; --b5: #8C7F78; --b6: #1A1318; --band: #CBBFB3;
      --city: #2E2030; --cloud: #6B4A68; --orb: #F4E6C8;
      --fur: #B07A55; --fur-line: #8A5A3C; --curtain: #5A3550; --frame: #CBBFB3; --neon: #F4B6CF;
      --lamp: #F2C46D; --leaf: #6F9A78; --leafdk: #557D5E;
    }
  }
  :global(:root[data-theme="dark"]) .shelf-scene {
    --n: 1;
    --wall: #2A1E2A; --case: #3A2A35; --board: #4A3743; --floor: #2D2129; --skirt: #3A2A35;
    --seat: #3A2A35; --seat-front: #2D2129; --cushion: #7A2E5C;
    --b1: #557D5E; --b2: #A86A50; --b3: #9C5A6C; --b4: #5E2347; --b5: #8C7F78; --b6: #1A1318; --band: #CBBFB3;
    --city: #2E2030; --cloud: #6B4A68; --orb: #F4E6C8;
    --fur: #B07A55; --fur-line: #8A5A3C; --curtain: #5A3550; --frame: #CBBFB3; --neon: #F4B6CF;
    --lamp: #F2C46D; --leaf: #6F9A78; --leafdk: #557D5E;
  }

