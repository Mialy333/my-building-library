---
import { getLocale, useTranslations, plural, type UiKey } from "../i18n/ui";
import {
  books, baa, conceptsOf, appliedIn, type Book, type Chapter, pad, publishedCount, progressPercent, chapterUrl, bookUrl, chapterLabelWithTheme, chapterSlug,
} from "../data/books";
import BookCover from "./BookCover.astro";
import DemoCard from "./DemoCard.astro";
import Breadcrumb from "./Breadcrumb.astro";
import ConceptList from "./ConceptList.astro";
import { glossary } from "../data/glossary";
import { certificationOf } from "../data/credentials";

interface Props {
  book: Book;
}

const { book } = Astro.props;
const certification = certificationOf(book.slug);
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const label = (c: Chapter) => chapterLabelWithTheme(c, t);

const journeys = books.filter((b) => b.shelf === "journeys");
// Published chapters with a live demo to show off, in the order of the contents.
const demos = book.chapters.filter((c) => c.published && c.showcase && c.demo);

const published = book.chapters.filter((c) => c.published);
const upcoming = book.chapters.filter((c) => !c.published);
const nextRows = upcoming.slice(0, 3);
const later = upcoming.slice(3);

const unit = (n: number) => plural(n, t("unit.chapter.one"), t("unit.chapter.other"));
const gaugeColor = book.color === "apricot" ? "var(--gauge-apricot)" : "var(--gauge-rose)";
const count = book.living
  ? t("book.open")
  : `${published.length} ${plural(published.length, t("book.publishedCount.one"), t("book.publishedCount.other"))} · ${upcoming.length} ${t("unit.toCome")}`;

const crumbs = [
  { label: t("nav.shelf"), href: `/${locale}/shelf/` },
  { label: book.name[locale] },
];
---

<article>
  <header class="intro">
    <Breadcrumb items={crumbs} />
    <p class="kicker">
      <span class="dot" style={`background: var(--book-${book.color})`} aria-hidden="true"></span>
      {t("shelf.rayon")} {t(`shelf.${book.shelf}` as UiKey)}
    </p>
    <div class="cover-wrap"><BookCover book={book} size="page" /></div>
    <h1>{book.heading.text[locale]}<em>{book.heading.accent[locale]}</em></h1>
    {book.meta && <p class="meta">{book.meta[locale]}</p>}
    {certification && (
      <p class="certificate">
        <span class="mono caps">
          {/* "Certificate · Nanodegree", but not "Certificate · Certificate of completion". */}
          {/certifica/i.test(certification.kind[locale]) ? "" : `${t("book.certificate")} · `}{certification.kind[locale]}{certification.date && ` · ${certification.date[locale]}`}
        </span>
        {certification.verify && <a href={certification.verify.url} target="_blank" rel="noopener">{certification.verify.label[locale]} ↗</a>}
      </p>
    )}

    {book.gauge && (
      <div class="gauge">
        <div class="rail"><div class="fill" style={`width: ${progressPercent(book)}%; background: ${gaugeColor}`}></div></div>
        <div class="gauge-label">
          <span>{publishedCount(book)}/{book.chapters.length} {unit(book.chapters.length)}</span>
          <span class="percent">{progressPercent(book)} %</span>
        </div>
      </div>
    )}

    {book.living && (
      <p class="living">
        <span class="living-title">{t("book.living")}</span>
        <span class="mono">
          · {published.length > 0
            ? `${published.length} ${unit(published.length)}`
            : `${book.chapters.length} ${unit(book.chapters.length)} ${t("unit.toCome")}`}
        </span>
      </p>
    )}
  </header>

  {book.summary && (
    <section class="reading">
      <h2>{t("book.summary")}</h2>
      {book.summary[locale].map((p) => <p class="body">{p}</p>)}
      {book.callout && (
        <aside class="callout">
          <p class="callout-label">{book.callout.label[locale]}</p>
          <p class="callout-text" set:html={book.callout.text[locale]} />
        </aside>
      )}
    </section>
  )}

  {demos.length > 0 && (
    <section class="demos">
      <h2>{t("demo.heading")}</h2>
      <p class="body">{t("demo.lead")}</p>
      <div class="demo-grid">
        {demos.map((c) => <DemoCard book={book} chapter={c} withChapterLink />)}
      </div>
    </section>
  )}

  {book === baa && (
    <div class="glossary-wrap">
      <a class="glossary-card" href={`/${locale}/books/${book.slug}/glossary/`}>
        <span class="mono caps">{t("glossary.title")} · {glossary.length} {t("glossary.terms")}</span>
        <span class="glossary-cta">{t("glossary.open")}</span>
      </a>
    </div>
  )}

  <section class="contents">
    <div class="head">
      <h2>{t("book.contents")}</h2>
      <span class="mono">{count}</span>
    </div>

    {book.living ? (
      <>
        {/* Jump bar: one number per chapter, stays under the header while scrolling. */}
        <nav class="toc-nums" aria-label={t("book.jump")}>
          {book.chapters.map((c) => <a href={`#ch-${pad(c.number)}`}>{pad(c.number)}</a>)}
        </nav>

        {/* Compact contents: one line per chapter, like a printed table of contents.
            Where the concept is applied is on the chapter page itself. */}
        <ol class="toc">
          {book.chapters.map((c) => {
            const uses = appliedIn(c).length;
            return (
              <li class="toc-row" id={`ch-${pad(c.number)}`}>
                <span class="toc-num">{pad(c.number)}</span>
                <span class="toc-body">
                  {c.published
                    ? <a class="toc-title" href={chapterUrl(locale, book, c)}>{c.title[locale]}</a>
                    : <span class="toc-title pending">{c.title[locale]}</span>}
                  <span class="toc-meta">
                    {c.published
                      ? (uses > 0 ? `${t("book.appliedIn")} ${uses} ${plural(uses, t("unit.chapter.one"), t("unit.chapter.other"))}` : t("book.published"))
                      : t("unit.toCome")}
                    {c.published && <span class="read-mark" data-read={`${book.slug}/${chapterSlug(c)}`} hidden>{t("chapter.read")}</span>}
                  </span>
                </span>
              </li>
            );
          })}
          <li class="next">
            <span class="mono caps">{t("label.chapter")} {pad(book.chapters.length + 1)}</span>
            <span class="next-text">{t("book.nextChapter")}</span>
          </li>
        </ol>
      </>
    ) : (
      <>
        <ol class="list">
          {published.map((c) => {
            const concepts = conceptsOf(c);
            return (
              <li class="card">
                <div class="card-head">
                  <span class="mono caps">{label(c)}</span>
                  <span class="pills"><span class="read-mark" data-read={`${book.slug}/${chapterSlug(c)}`} hidden>{t("chapter.read")}</span><span class="pill">{t("book.published")}</span></span>
                </div>
                <a class="card-link" href={chapterUrl(locale, book, c)}>
                  <span class="card-title">{c.title[locale]}</span>
                  {c.teaser && <span class="teaser">{c.teaser[locale]}</span>}
                  <span class="read">{t("book.read")}</span>
                </a>
                <ConceptList concepts={concepts} />
              </li>
            );
          })}
          {nextRows.map((c) => (
            <li class="row">
              <span class="row-text">
                <span class="mono caps">{label(c)}</span>
                <span class="row-title">{c.title[locale]}</span>
              </span>
              <span class="mono">{t("unit.toCome")}</span>
            </li>
          ))}
        </ol>

        {later.length > 0 && (
          <details class="more">
            <summary>+ {later.length} {t("unit.toCome")}</summary>
            <ul class="later">
              {later.map((c) => (
                <li>
                  <span class="mono caps">{label(c)}</span>
                  <span class="later-title">{c.title[locale]}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </>
    )}
  </section>

  {!book.living && (book.repo || baa) && (
    <div class="actions">
      {book.repo && <a class="button" href={book.repo} rel="noopener">{t("book.repo")}</a>}
      {baa && <a class="button primary" href={bookUrl(locale, baa)}>{t("book.seeBaa")}</a>}
    </div>
  )}

  {book.living && (
    <section class="fed">
      <h2 set:html={t("book.fedBy")} />
      <ul class="fed-list">
        {journeys.map((j) => (
          <li>
            <a href={bookUrl(locale, j)} style={`--bar: var(--book-${j.color})`}>
              <span class="mono">BOOK {pad(books.indexOf(j) + 1)}</span>
              <span class="fed-title">{j.heading.text[locale]}{j.heading.accent[locale]}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</article>

<style>
  .intro { padding: 12px 24px 0; }
  .kicker {
    display: flex; align-items: center; gap: 10px; margin: 12px 0 0;
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 2px; text-transform: uppercase; color: var(--ink-muted);
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; }
  .cover-wrap { display: flex; justify-content: center; margin-top: 26px; }
  h1 { margin: 30px 0 0; font-family: var(--font-serif); font-weight: 400; font-size: 46px; line-height: 0.98; letter-spacing: -1px; }
  .meta { margin: 12px 0 0; font-family: var(--font-mono); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-muted); }
  .mono { font-family: var(--font-mono); font-size: 13px; color: var(--ink-muted); }
  .caps { letter-spacing: 2px; text-transform: uppercase; }
  .gauge { margin-top: 20px; }
  .rail { height: 6px; border-radius: 3px; background: var(--rule); overflow: hidden; }
  .fill { height: 6px; border-radius: 3px; }
  .gauge-label { display: flex; justify-content: space-between; margin-top: 8px; font-family: var(--font-mono); font-size: 13px; color: var(--ink-muted); }
  .percent { color: var(--ink); }
  .living { display: flex; align-items: baseline; gap: 10px; margin: 14px 0 0; }
  .living-title { font-family: var(--font-serif); font-style: italic; font-size: 24px; color: var(--accent-text); }

  h2 { margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: 32px; line-height: 1; }
  .reading { padding: 44px 24px 0; }
  /* "To try": the demo posters, one under the other, two side by side from 640 px. */
  .demos { padding: 44px 24px 0; }
  .demo-grid { display: grid; gap: 36px; margin-top: 24px; }
  @media (min-width: 640px) {
    .demo-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
  }
  .body { margin: 14px 0 0; font-family: var(--font-reading); font-size: 19px; line-height: 1.6; }
  .callout { margin: 28px 6px 0 0; padding: 20px 22px; border-radius: 18px; background: var(--blush); box-shadow: 6px 6px 0 var(--shadow); }
  .callout-label { margin: 0; font-family: var(--font-mono); font-size: 13px; letter-spacing: 2px; text-transform: uppercase; color: var(--accent-text); }
  .callout-text { margin: 10px 0 0; font-family: var(--font-serif); font-size: 28px; line-height: 1.08; }

  .contents { padding: 48px 24px 0; }
  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .list { display: flex; flex-direction: column; gap: 10px; margin: 16px 0 0; padding: 0; list-style: none; }
  .card { padding: 16px 18px; background: var(--card); border: 1px solid var(--line); border-radius: 16px; }
  .card-head { display: flex; align-items: center; justify-content: space-between; }
  .pill { font-family: var(--font-mono); font-size: 13px; padding: 3px 10px; border-radius: 999px; background: var(--published-bg); color: var(--published-ink); }
  .pill.pending { background: none; border: 1px dashed var(--ink-faint); color: var(--ink-muted); }
  .card-link { display: block; margin-top: 8px; color: var(--ink); text-decoration: none; }
  .card-title { display: block; margin: 8px 0 0; font-family: var(--font-serif); font-size: 28px; line-height: 1.02; color: var(--ink); }
  .card-link .card-title { margin: 0; }
  .card-title.link { text-decoration: none; }
  .teaser { display: block; margin-top: 8px; font-family: var(--font-reading); font-size: 17px; line-height: 1.5; color: var(--ink-soft); }
  .read { display: flex; align-items: center; min-height: 44px; font-size: 16px; font-weight: 600; color: var(--accent-text); }
  .concept { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--rule); }
  .mono-label { margin: 0; font-family: var(--font-mono); font-size: 13px; letter-spacing: 2px; text-transform: uppercase; color: var(--ink-muted); }
  .applied { display: flex; align-items: center; min-height: 44px; font-size: 16px; font-weight: 600; text-decoration: none; }
  .row {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; padding: 10px 18px;
    border: 1px dashed var(--ink-faint); border-radius: 12px;
  }
  .row-text { display: flex; flex-direction: column; }
  .row-title { font-family: var(--font-serif); font-size: 20px; line-height: 1.15; color: var(--ink-soft); }
  .next { padding: 18px; border: 1px dashed var(--ink-faint); border-radius: 16px; text-align: center; }
  .next .mono { display: block; }
  .next-text { display: block; margin-top: 6px; font-family: var(--font-serif); font-style: italic; font-size: 20px; color: var(--ink-soft); }
  .more { margin-top: 8px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); }
  .more summary { display: flex; align-items: center; min-height: 52px; padding: 0 18px; cursor: pointer; font-size: 16px; font-weight: 500; }
  .later { margin: 0; padding: 0 18px 12px; list-style: none; }
  .later li { display: flex; align-items: baseline; gap: 12px; padding: 10px 0; border-top: 1px solid var(--rule); }
  .later .mono { flex-shrink: 0; min-width: 96px; }
  .later-title { font-family: var(--font-serif); font-size: 18px; line-height: 1.2; color: var(--ink-soft); }

  .glossary-wrap { padding: 32px 24px 0; }
  .glossary-card {
    display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border-radius: 16px;
    background: var(--blush); box-shadow: 6px 6px 0 var(--shadow); color: var(--ink); text-decoration: none;
  }
  .glossary-cta { font-family: var(--font-serif); font-size: 26px; line-height: 1.1; color: var(--accent-text); }

  .actions { display: flex; gap: 12px; padding: 40px 24px 0; }
  .button {
    flex-grow: 1; display: flex; align-items: center; justify-content: center; min-height: 48px;
    border: 1px solid var(--ink); border-radius: 999px; background: var(--card);
    color: var(--ink); font-size: 16px; font-weight: 500; text-decoration: none;
  }
  .button.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 600; }

  .fed { padding: 44px 24px 0; }
  .fed-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 14px 0 0; padding: 0; list-style: none; }
  .fed-list a {
    display: flex; flex-direction: column; justify-content: center; min-height: 72px; padding: 12px 14px 12px 18px;
    border: 1px solid var(--line); border-radius: 14px; color: var(--ink); text-decoration: none;
    background: linear-gradient(90deg, var(--bar) 0 5px, transparent 5px), var(--card);
  }
  .fed-title { font-family: var(--font-serif); font-size: 20px; line-height: 1.1; margin-top: 2px; }

  /* "Read" mark next to "Published", shown by the script below. */
  .pills { display: inline-flex; align-items: center; gap: 8px; }
  .read-mark {
    padding: 2px 9px; border: 1.5px solid var(--accent-text); border-radius: 999px;
    font-family: var(--font-mono); font-size: 13px; font-weight: 500; letter-spacing: 1px;
    text-transform: uppercase; color: var(--accent-text); transform: rotate(-6deg);
  }
  .read-mark[hidden] { display: none; }

  /* Living book: compact contents. */
  .toc-nums {
    position: sticky; top: 64px; z-index: 1;
    display: flex; flex-wrap: wrap; gap: 2px; margin: 16px -24px 0; padding: 6px 20px;
    background: var(--paper); border-block: 1px solid var(--line);
  }
  .toc-nums a {
    display: inline-flex; align-items: center; justify-content: center; min-width: 40px; min-height: 44px;
    font-family: var(--font-mono); font-size: 15px; color: var(--ink); text-decoration: none;
  }
  .toc-nums a:hover { color: var(--accent-text); }
  .toc { margin: 8px 0 0; padding: 0; list-style: none; }
  .toc-row {
    display: flex; align-items: baseline; gap: 14px; padding: 14px 0;
    border-bottom: 1px solid var(--rule); scroll-margin-top: 190px;
  }
  .toc-row:target { background: linear-gradient(90deg, var(--blush), transparent); }
  .toc-num { flex: none; width: 28px; font-family: var(--font-mono); font-size: 14px; color: var(--ink-muted); }
  .toc-body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .toc-title { font-family: var(--font-serif); font-size: 22px; line-height: 1.15; color: var(--ink); text-decoration: none; }
  a.toc-title:hover { color: var(--accent-text); text-decoration: underline; text-underline-offset: 3px; }
  .toc-title.pending { color: var(--ink-muted); }
  .toc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 13px; color: var(--ink-muted); }
  .toc + .next, .toc .next { margin-top: 16px; }

  /* Certificate of the programme, with its official verification link. */
  .certificate { display: flex; flex-wrap: wrap; align-items: center; gap: 0 14px; margin: 10px 0 0; }
  .certificate a { display: inline-flex; align-items: center; min-height: 44px; font-size: 16px; font-weight: 600; text-underline-offset: 3px; }
</style>

<script>
  // Shows "Read" on chapters this browser has already read to the end
  // (stored by the chapter page). Without localStorage, nothing is shown.
  document.querySelectorAll<HTMLElement>("[data-read]").forEach((mark) => {
    try {
      if (localStorage.getItem(`read:${mark.dataset.read}`) === "1") mark.hidden = false;
    } catch {}
  });
</script>
