---
// About page: portrait, profiles, Mialy's own text (src/data/about.ts, pushed
// section by section: looking for, what I bring, values, path in short, initiatives, inspirations), stack and certifications. What is not written yet is
// shown as "coming soon", like everywhere else in the library.
import { Image } from "astro:assets";
import { getLocale, useTranslations } from "../i18n/ui";
import { books, bookUrl } from "../data/books";
import { stack, certifications, proofHref } from "../data/credentials";
import { stackIcons } from "../data/stack-icons";
import { lookingFor, bring, values, path, initiatives, inspirations } from "../data/about";
import SocialLinks from "./SocialLinks.astro";
import portrait from "../assets/mialy.jpg";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
// A certificate may have no book on the site (a short course): no book link then.
const pathBook = books.find((b) => b.slug === path.book);
const bookName = (slug?: string) => (slug ? books.find((b) => b.slug === slug) : undefined);
---

<article class="about">
  <header class="hero">
    <div class="arch">
      <Image class="photo" src={portrait} alt={t("author.photoAlt")} widths={[200, 400, 600]} sizes="200px" loading="eager" />
    </div>
    <p class="kicker">{t("author.kicker")}</p>
    <h1 set:html={t("soon.about")} />
    <p class="line" set:html={t("author.line")} />
    <SocialLinks />
  </header>

  <details class="block fold" open>
    <summary><h2 id="looking-title" set:html={lookingFor.title[locale]} /></summary>
    <p class="text" set:html={lookingFor.text[locale]} />
    {/* Quick-scan card: what a recruiter checks first, in two seconds. */}
    <dl class="facts">
      {lookingFor.facts.map((f) => (
        <div class="fact">
          <dt>{f.label[locale]}</dt>
          <dd>{f.value[locale]}</dd>
        </div>
      ))}
    </dl>
  </details>

  <details class="block fold">
    <summary><h2 id="bring-title" set:html={bring.title[locale]} /></summary>
    <ul class="strengths">
      {bring.items.map((item) => (
        <li class="strength">
          <h3 class="strength-title">{item.title[locale]}</h3>
          <p class="strength-text">{item.text[locale]}</p>
          {item.proofs.length > 0 && (
            <span class="proofs">
              {item.proofs.map((p) => {
                const href = proofHref(p.proof, locale);
                const external = "url" in p.proof;
                return href ? (
                  <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>
                    {p.label[locale]}{external ? " ↗" : ""}
                  </a>
                ) : <span>{p.label[locale]}</span>;
              })}
            </span>
          )}
        </li>
      ))}
    </ul>
  </details>

  <details class="block fold">
    <summary><h2 id="values-title" set:html={values.title[locale]} /></summary>
    <ul class="strengths">
      {values.items.map((item) => (
        <li class="strength">
          <h3 class="strength-title">{item.title[locale]}</h3>
          <p class="strength-text">{item.text[locale]}</p>
          {item.proofs.length > 0 && (
            <span class="proofs">
              {item.proofs.map((p) => {
                const href = proofHref(p.proof, locale);
                const external = "url" in p.proof;
                return href ? (
                  <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>
                    {p.label[locale]}{external ? " ↗" : ""}
                  </a>
                ) : <span>{p.label[locale]}</span>;
              })}
            </span>
          )}
        </li>
      ))}
    </ul>
  </details>

  <details class="block fold">
    <summary><h2 id="path-title" set:html={path.title[locale]} /></summary>
    {/* A short timeline: same thread and plum dots as the certificate stages. */}
    <ol class="periods">
      {path.periods.map((p) => (
        <li class="period">
          <span class="period-years">{p.years}</span>
          <h3 class="period-title">{p.title[locale]}</h3>
          <p class="period-text">{p.text[locale]}</p>
        </li>
      ))}
    </ol>
    {pathBook && (
      <p class="path-book">
        {path.bookLine[locale]} <a href={bookUrl(locale, pathBook)}>{pathBook.name[locale]} →</a>
      </p>
    )}
  </details>

  <details class="block fold">
    <summary><h2 id="initiatives-title" set:html={initiatives.title[locale]} /></summary>
    <ul class="initiatives">
      {initiatives.items.map((it) => (
        <li class="initiative">
          {it.image && (
            <Image class="shot" src={it.image.src} alt={it.image.alt[locale]} widths={[340, 680]} sizes="(min-width: 720px) 640px, calc(100vw - 86px)" />
          )}
          <span class="initiative-meta">
            {it.when[locale]}
            {it.status && <span class="status">{it.status[locale]}</span>}
          </span>
          <h3 class="initiative-name">{it.name}</h3>
          <span class="initiative-role">{it.role[locale]}</span>
          <p class="initiative-text">{it.text[locale]}</p>
          {it.links && it.links.length > 0 && (
            <span class="cert-links">
              {it.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label[locale]} ↗</a>)}
            </span>
          )}
        </li>
      ))}
    </ul>
  </details>

  <details class="block fold">
    <summary><h2 id="inspirations-title" set:html={inspirations.title[locale]} /></summary>
    <ul class="strengths">
      {inspirations.items.map((it) => (
        <li class="strength">
          <h3 class="strength-title">{it.name}</h3>
          <a class="channel" href={it.url} target="_blank" rel="noopener">{it.channel} ↗</a>
          <p class="strength-text">{it.text[locale]}</p>
        </li>
      ))}
    </ul>
  </details>

  <details class="block fold">
    <summary><h2 id="stack-title" set:html={t("about.stack")} /></summary>
    <p class="lead">{t("about.stackLead")}</p>
    {stack.map((group) => (
      <div class="group">
        <h3 class="group-title">
          {group.icon && (
            <svg class="group-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={stackIcons[group.icon]} />
          )}
          {group.title[locale]}
        </h3>
        {/* One small tile per tool: icon, name, what exactly, and where it was used. */}
        <ul class="tiles">
          {group.items.map((item) => (
            <li class="tile">
              <span class="tile-head">
                <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={stackIcons[item.icon]} />
                <span class="tile-name">{item.name}</span>
              </span>
              {item.detail && <span class="tile-detail">{item.detail[locale]}</span>}
              {item.proofs.length > 0 && (
                <span class="tile-proofs">
                  {item.proofs.map((p) => {
                    const href = proofHref(p, locale);
                    const external = "url" in p;
                    return href ? (
                      <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>
                        {p.label}{external ? " ↗" : ""}
                      </a>
                    ) : (
                      <span>{p.label}</span>
                    );
                  })}
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </details>

  <details class="block fold">
    <summary><h2 id="cert-title" set:html={t("about.certs")} /></summary>
    <ul class="certs">
      {certifications.map((c) => {
        const book = bookName(c.book);
        const several = c.stages.length > 1;
        return (
          <li class="cert">
            <span class="cert-issuer">{c.issuer}</span>
            <h3 class="cert-title">{c.title}</h3>
            {c.about && <p class="cert-about">{c.about[locale]}</p>}
            {c.source && (
              <a class="cert-source" href={c.source.url} target="_blank" rel="noopener">{c.source.label[locale]} ↗</a>
            )}
            {/* One stage per certificate; several stages read as a small timeline. */}
            <ol class:list={["stages", { timeline: several }]}>
              {c.stages.map((s, i) => (
                <li class="stage">
                  {/* The certificate itself, as a thumbnail: a tap opens the official verification page. */}
                  <a class="thumb" href={s.verify.url} target="_blank" rel="noopener">
                    <Image src={s.image} alt={s.imageAlt[locale]} widths={[200, 400, 600]} sizes="(min-width: 640px) 180px, 160px" />
                  </a>
                  <div class="stage-text">
                    <span class="stage-kind">{several && <>{t("about.stage")} {i + 1} · </>}{s.kind[locale]} · {s.date[locale]}</span>
                    {several && <span class="stage-title">{s.title}</span>}
                    <p class="stage-about">{s.about[locale]}</p>
                    {s.id && <span class="stage-id">ID {s.id}</span>}
                    <span class="cert-links">
                      <a href={s.verify.url} target="_blank" rel="noopener">{s.verify.label[locale]} ↗</a>
                      {s.extra && <a href={s.extra.url} target="_blank" rel="noopener">{s.extra.label[locale]} ↗</a>}
                    </span>
                  </div>
                </li>
              ))}
            </ol>
            {book && <a class="cert-book" href={bookUrl(locale, book)}>{t("about.readBook")} →</a>}
          </li>
        );
      })}
    </ul>
  </details>
</article>

<script>
  // A link to an anchor inside a closed section (e.g. #stack-title) opens that section first.
  function openTarget() {
    const id = decodeURIComponent(location.hash.slice(1));
    const el = id ? document.getElementById(id) : null;
    const fold = el?.closest("details");
    if (fold && !fold.open) { fold.open = true; el.scrollIntoView(); }
  }
  openTarget();
  window.addEventListener("hashchange", openTarget);
</script>

<style>
  .about { padding: 32px 24px 0; }
  .hero { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .arch {
    position: relative; width: 200px; height: 250px; overflow: hidden;
    border: 1px solid var(--line); border-radius: 999px 999px 16px 16px;
    background: var(--blush); box-shadow: 6px 6px 0 var(--shadow);
  }
  /* Same treatment as on the home page: slightly softened, plum veil. */
  .arch :global(.photo) {
    display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%;
    filter: saturate(0.85) contrast(0.97);
  }
  .arch::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(243, 196, 166, 0.35), rgba(122, 46, 92, 0.35));
    mix-blend-mode: soft-light;
  }
  .kicker {
    margin: 28px 0 0; font-family: var(--font-mono); font-size: 13px; letter-spacing: 2px;
    text-transform: uppercase; color: var(--ink-muted);
  }
  h1 { margin: 10px 0 0; font-family: var(--font-serif); font-weight: 400; font-size: 62px; line-height: 0.94; letter-spacing: -1.5px; }
  .line { max-width: 24ch; margin: 14px 0 20px; font-family: var(--font-serif); font-size: 24px; line-height: 1.15; }
  .hero :global(.socials) { justify-content: center; }

  .block { margin-top: 48px; }
  /* Folding sections: the titles read like a table of contents; one tap opens a part.
     Native <details>/<summary>: works without JavaScript, keyboard and screen readers included. */
  .fold { margin-top: 0; border-bottom: 1px solid var(--line); }
  .hero + .fold { margin-top: 40px; border-top: 1px solid var(--line); }
  .fold > summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    min-height: 64px; padding: 10px 2px; cursor: pointer; list-style: none;
  }
  .fold > summary::-webkit-details-marker { display: none; }
  /* Chevron in plum: points down when closed, up when open. */
  .fold > summary::after {
    content: ""; flex: none; width: 10px; height: 10px; margin: -4px 6px 0 0;
    border-right: 2px solid var(--accent-text); border-bottom: 2px solid var(--accent-text);
    transform: rotate(45deg); transition: transform 0.2s ease;
  }
  .fold[open] > summary::after { transform: rotate(-135deg); margin-top: 6px; }
  .fold > summary:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; border-radius: 6px; }
  .fold > summary h2 { margin: 0; }
  .fold[open] { padding-bottom: 32px; }
  .fold + .block:not(.fold), .block:not(.fold) + .fold { margin-top: 32px; }
  .block:not(.fold) + .fold { border-top: 1px solid var(--line); }
  @media (prefers-reduced-motion: reduce) { .fold > summary::after { transition: none; } }
  h2 { margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: 34px; line-height: 1.05; }
  .lead { margin: 8px 0 0; font-size: 16px; line-height: 1.55; color: var(--ink-soft); }

  /* Reading text, same voice as the chapters (Newsreader). */
  .text { margin: 14px 0 0; font-family: var(--font-reading); font-size: 19px; line-height: 1.6; color: var(--ink); }
  .text :global(strong) { font-weight: 600; }
  .facts {
    margin: 20px 0 0; padding: 4px 18px; background: var(--card);
    border: 1px solid var(--ink); border-radius: 16px; box-shadow: 5px 5px 0 var(--shadow);
  }
  .fact { display: flex; flex-direction: column; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .fact:last-child { border-bottom: 0; }
  .fact dt { font-family: var(--font-mono); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-muted); }
  .fact dd { margin: 0; font-size: 17px; line-height: 1.45; }
  /* Wider screens: label column on the left, like a library card. */
  @media (min-width: 640px) {
    .fact { display: grid; grid-template-columns: 140px 1fr; gap: 16px; align-items: baseline; }
  }

  .strengths { margin: 10px 0 0; padding: 0; list-style: none; }
  .strength { padding: 16px 0; border-bottom: 1px solid var(--rule); }
  .strength:last-child { border-bottom: 0; }
  .strength-title { margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: 23px; line-height: 1.15; }
  .strength-text { margin: 6px 0 0; font-family: var(--font-reading); font-size: 18px; line-height: 1.55; color: var(--ink-soft); }
  .strength .proofs { margin-top: 6px; }
  .channel { display: inline-flex; align-items: center; min-height: 32px; font-family: var(--font-mono); font-size: 13px; text-underline-offset: 3px; }

  .periods { position: relative; margin: 16px 0 0; padding: 0 0 0 22px; list-style: none; }
  .periods::before { content: ""; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 2px; background: var(--line); }
  .period { position: relative; padding: 0 0 18px; }
  .period:last-child { padding-bottom: 0; }
  .period::before {
    content: ""; position: absolute; left: -22px; top: 4px; width: 12px; height: 12px;
    border: 2px solid var(--paper); border-radius: 50%; background: var(--accent-text);
  }
  .period-years { font-family: var(--font-mono); font-size: 13px; letter-spacing: 1px; color: var(--ink-muted); }
  .period-title { margin: 2px 0 0; font-family: var(--font-serif); font-weight: 400; font-size: 22px; line-height: 1.15; }
  .period-text { margin: 4px 0 0; font-family: var(--font-reading); font-size: 18px; line-height: 1.55; color: var(--ink-soft); }
  .path-book { margin: 18px 0 0; font-size: 16px; color: var(--ink-soft); }
  .path-book a { font-weight: 600; text-underline-offset: 3px; }

  .initiatives { display: flex; flex-direction: column; gap: 16px; margin: 18px 0 0; padding: 0; list-style: none; }
  .initiative {
    display: flex; flex-direction: column; gap: 4px; padding: 18px;
    background: var(--card); border: 1px solid var(--ink); border-radius: 16px; box-shadow: 5px 5px 0 var(--shadow);
  }
  .initiative :global(.shot) { display: block; width: 100%; height: auto; margin-bottom: 10px; border: 1px solid var(--line); border-radius: 10px; }
  .initiative-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-family: var(--font-mono); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-muted); }
  /* "On pause": said plainly, as a small tag. */
  .status { padding: 2px 8px; border: 1px solid var(--ink-faint); border-radius: 999px; font-size: 12px; }
  .initiative-name { margin: 2px 0 0; font-family: var(--font-serif); font-weight: 400; font-size: 24px; line-height: 1.1; }
  .initiative-role { font-size: 15px; color: var(--ink-soft); }
  .initiative-text { margin: 6px 0 0; font-family: var(--font-reading); font-size: 18px; line-height: 1.55; color: var(--ink-soft); }


  .group { margin-top: 28px; }
  /* Group title, centred between two rules, like a chapter divider. */
  .group-title {
    display: flex; align-items: center; gap: 14px; margin: 0 0 6px;
    font-family: var(--font-mono); font-weight: 500; font-size: 17px; letter-spacing: 3px;
    text-transform: uppercase; color: var(--ink);
  }
  .group-title::before, .group-title::after { content: ""; flex-grow: 1; height: 1px; background: var(--line); }
  .group-icon { width: 22px; height: 22px; flex: none; color: var(--accent-text); }
  /* Tiles: two per row on a phone, more on wider screens; much shorter than a list. */
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(148px, 1fr)); gap: 8px; margin: 14px 0 0; padding: 0; list-style: none; }
  .tile {
    display: flex; flex-direction: column; gap: 2px; padding: 10px 12px 6px;
    background: var(--card); border: 1px solid var(--line); border-radius: 12px;
  }
  /* Icon beside the name, so each tile stays short. */
  .tile-head { display: flex; align-items: flex-start; gap: 8px; }
  .tile-icon { width: 22px; height: 22px; flex: none; margin-top: 1px; color: var(--accent-text); }
  .tile-name { font-family: var(--font-serif); font-size: 18px; line-height: 1.15; }
  .tile-detail { font-size: 13px; line-height: 1.35; color: var(--ink-soft); }
  .tile-proofs { display: flex; flex-wrap: wrap; gap: 0 8px; margin-top: 2px; font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); }
  .tile-proofs a { display: inline-flex; align-items: center; min-height: 32px; text-underline-offset: 3px; }
  .proofs { display: flex; flex-wrap: wrap; gap: 4px 10px; width: 100%; font-family: var(--font-mono); font-size: 13px; color: var(--ink-muted); }
  .proofs a { display: inline-flex; align-items: center; min-height: 32px; text-underline-offset: 3px; }

  .certs { display: flex; flex-direction: column; gap: 16px; margin: 18px 0 0; padding: 0; list-style: none; }
  .cert {
    display: flex; flex-direction: column; gap: 4px; padding: 18px;
    background: var(--card); border: 1px solid var(--ink); border-radius: 16px; box-shadow: 5px 5px 0 var(--shadow);
  }
  .cert-issuer { font-family: var(--font-mono); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-muted); }
  .cert-title { margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: 24px; line-height: 1.1; }
  .cert-source { align-self: flex-start; display: inline-flex; align-items: center; min-height: 32px; font-family: var(--font-mono); font-size: 13px; text-underline-offset: 3px; }
  .cert-about { margin: 2px 0 0; font-size: 16px; line-height: 1.5; color: var(--ink-soft); }

  .stages { display: flex; flex-direction: column; gap: 18px; margin: 14px 0 0; padding: 0; list-style: none; }
  /* Several stages: a plum thread with a dot per stage, like a bookmark ribbon. */
  .timeline { position: relative; padding-left: 22px; }
  .timeline::before { content: ""; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 2px; background: var(--line); }
  .timeline .stage { position: relative; }
  .timeline .stage::before {
    content: ""; position: absolute; left: -22px; top: 4px; width: 12px; height: 12px;
    border: 2px solid var(--card); border-radius: 50%; background: var(--accent-text);
  }
  .stage { display: flex; flex-direction: column; gap: 10px; }
  /* Thumbnail: big enough to recognise the certificate, small enough not to take the page. */
  .thumb { display: block; width: 160px; max-width: 100%; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .thumb :global(img) { display: block; width: 100%; height: auto; }
  .thumb:hover, .thumb:focus-visible { border-color: var(--accent-text); }
  .stage-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .stage-kind { font-family: var(--font-mono); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-muted); }
  .stage-title { font-family: var(--font-serif); font-size: 20px; line-height: 1.15; }
  .stage-about { margin: 2px 0 0; font-size: 15px; line-height: 1.5; color: var(--ink-soft); }
  .stage-id { font-family: var(--font-mono); font-size: 13px; color: var(--ink-muted); }
  .cert-links { display: flex; flex-wrap: wrap; gap: 0 18px; }
  .cert-links a, .cert-book { display: inline-flex; align-items: center; min-height: 44px; font-size: 16px; font-weight: 600; text-underline-offset: 3px; }
  .cert-book { align-self: flex-start; margin-top: 4px; }

  /* Wider screens: thumbnail on the left, text on the right. */
  @media (min-width: 640px) {
    .stage { flex-direction: row; align-items: flex-start; gap: 18px; }
    .thumb { flex: none; width: 180px; }
  }
</style>
