---
import { getEntry, render } from "astro:content";
import { getLocale, useTranslations } from "../i18n/ui";
import { baa, conceptsOf, appliedIn, type Book, type Chapter, bookUrl, chapterUrl, chapterLabel, chapterSlug } from "../data/books";
import Breadcrumb from "./Breadcrumb.astro";
import ConceptList from "./ConceptList.astro";
import DemoCard from "./DemoCard.astro";
import { techIcons } from "../data/tech-icons";

interface Props {
  book: Book;
  chapter: Chapter;
}

const { book, chapter } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const slug = chapterSlug(chapter);
const id = `${locale}/${book.slug}/${slug}`;
const entry = await getEntry("chapters", id);
const missingPath = `src/content/chapters/${id}.md`;

if (!entry && import.meta.env.PROD) {
  throw new Error(`Chapitre publié sans texte : ${missingPath}`);
}

const Content = entry ? (await render(entry)).Content : null;
const workedOn = entry?.data.workedOn
  ? new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric" }).format(entry.data.workedOn)
  : null;

// Reading time: words in the Markdown source, at about 200 words a minute.
const words = entry?.body ? entry.body.split(/\s+/).filter(Boolean).length : 0;
const minutes = Math.max(1, Math.round(words / 200));
// Key of the "read" stamp, the same in FR and EN: reading one language marks both.
const readKey = `${book.slug}/${slug}`;

const concepts = conceptsOf(chapter);
const uses = book === baa ? appliedIn(chapter) : [];
const repo = chapter.repo ?? book.repo;
// The chapter's links, in reading order: code, DEV post, demo, video.
// A link the chapter doesn't have is simply left out.
const links = [
  { href: repo, label: t("chapter.code") },
  { href: chapter.post, label: t("chapter.post") },
  { href: chapter.demo, label: t("chapter.demo") },
  { href: chapter.video, label: t("chapter.video") },
].filter((l): l is { href: string; label: string } => !!l.href);
const index = book.chapters.indexOf(chapter);
// The chapters on each side, for the "previous / next" navigation at the end.
const prev = index > 0 ? book.chapters[index - 1] : undefined;
const next = book.chapters[index + 1];

const crumbs = [
  { label: t("nav.shelf"), href: `/${locale}/shelf/` },
  { label: book.name[locale], href: bookUrl(locale, book) },
  { label: chapterLabel(chapter, t) },
];
---

<div class="progress" aria-hidden="true"></div>

<article class="chapter" data-read-key={readKey}>
  <Breadcrumb items={crumbs} />

  <header>
    <p class="label">
      <span class="bar" style={`background: var(--book-${book.color})`} aria-hidden="true"></span>
      {book.name[locale]} · {chapterLabel(chapter, t)}
    </p>
    {chapter.theme && (
      <p class="theme"><span>{t("chapter.theme")}</span> <em>{chapter.theme}</em></p>
    )}
    <h1>{chapter.title[locale]}</h1>
    <p class="meta">
      {workedOn && <span>{t("chapter.workedOn")} {workedOn} · </span>}
      <span>{minutes} {t("chapter.minutes")}</span>
      <span class="stamp" data-read-stamp hidden>{t("chapter.read")}</span>
    </p>
  </header>

  {chapter.showcase && chapter.demo && (
    <div class="demo-top"><DemoCard book={book} chapter={chapter} /></div>
  )}

  {Content ? (
    <div class="prose"><Content /></div>
  ) : (
    <p class="missing">{t("chapter.missing")} <code>{missingPath}</code></p>
  )}

  <div class="end-mark" data-read-end aria-hidden="true"></div>

  <footer class="end">
    {concepts.length > 0 && (
      <div class="block">
        <ConceptList concepts={concepts} bordered={false} />
      </div>
    )}

    {uses.length > 0 && (
      <div class="block">
        <p class="mono-label">{t("book.appliedIn")}</p>
        {uses.map((u) => (
          <a class="applied" href={chapterUrl(locale, u.book, u.chapter)}>
            <span class="mono">{u.book.name[locale]} · {chapterLabel(u.chapter, t)}</span>
            <span class="applied-title">{u.chapter.title[locale]} →</span>
          </a>
        ))}
      </div>
    )}

    {chapter.stack && chapter.stack.length > 0 && (
      <div class="block">
        <p class="mono-label">{t("chapter.stack")}</p>
        <ul class="stack">
          {chapter.stack.map((tech) => {
            const icon = techIcons[tech.icon];
            // Tabler icons are drawn with a stroke, Simple Icons are filled shapes.
            const draw = icon.kind === "fill"
              ? ({ fill: "currentColor", stroke: "none" } as const)
              : ({ fill: "none", stroke: "currentColor", "stroke-width": 1.6, "stroke-linecap": "round", "stroke-linejoin": "round" } as const);
            return (
              <li class:list={["tech", { partner: tech.partner }]}>
                <svg class="tech-icon" viewBox="0 0 24 24" aria-hidden="true" {...draw} set:html={icon.svg} />
                <span>{tech.name}</span>
                {tech.partner && <span class="tech-partner">{t("chapter.partner")}</span>}
              </li>
            );
          })}
        </ul>
      </div>
    )}

    {links.length > 0 && (
      <p class="links">
        {links.map((l) => <a class="code" href={l.href} rel="noopener">{l.label}</a>)}
      </p>
    )}

    {(prev || next) && (
      <nav class="block pager" aria-label={t("chapter.pager")}>
        {prev && (prev.published ? (
          <a class="pager-link" href={chapterUrl(locale, book, prev)}>
            <span class="mono-label">← {t("chapter.prev")}</span>
            <span class="mono">{chapterLabel(prev, t)}</span>
            <span class="next-title">{prev.title[locale]}</span>
          </a>
        ) : (
          <p class="pager-pending">
            <span class="mono-label">← {t("chapter.prev")}</span>
            <span class="mono">{chapterLabel(prev, t)} · {t("unit.toCome")}</span>
            <span class="next-title">{prev.title[locale]}</span>
          </p>
        ))}
        {next && (next.published ? (
          <a class="pager-link to-next" href={chapterUrl(locale, book, next)}>
            <span class="mono-label">{t("chapter.next")} →</span>
            <span class="mono">{chapterLabel(next, t)}</span>
            <span class="next-title">{next.title[locale]}</span>
          </a>
        ) : (
          <p class="pager-pending to-next">
            <span class="mono-label">{t("chapter.next")} →</span>
            <span class="mono">{chapterLabel(next, t)} · {t("unit.toCome")}</span>
            <span class="next-title">{next.title[locale]}</span>
          </p>
        ))}
      </nav>
    )}
  </footer>
</article>

<style>
  .chapter { padding: 12px 24px 0; }
  header { margin-top: 12px; }
  .label {
    display: flex; align-items: center; gap: 10px; margin: 0;
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 2px; text-transform: uppercase; color: var(--ink-muted);
  }
  .bar { width: 5px; height: 16px; border-radius: 2px; }
  h1 { margin: 14px 0 0; font-family: var(--font-serif); font-weight: 400; font-size: 40px; line-height: 1.02; letter-spacing: -0.5px; }
  .meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; margin: 12px 0 0;
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-muted);
  }

  /* "Read" stamp: same family as the "coming soon" stamp on covers. */
  .stamp {
    margin-left: 8px; padding: 3px 10px; border: 1.5px solid var(--accent-text); border-radius: 999px;
    color: var(--accent-text); font-weight: 500; letter-spacing: 2px; transform: rotate(-6deg);
  }
  .stamp[hidden] { display: none; }
  .stamp.fresh { animation: read-stamp .45s cubic-bezier(.2, .7, .2, 1.4) both; }
  @keyframes read-stamp { from { opacity: 0; transform: rotate(-6deg) scale(1.8); } to { opacity: 1; transform: rotate(-6deg) scale(1); } }

  /* Reading ribbon: a plum line under the header that grows as you scroll.
     Driven by the scroll itself (no JavaScript); hidden in browsers that
     cannot do it. */
  .progress { display: none; }
  @supports (animation-timeline: scroll()) {
    .progress {
      display: block; position: fixed; top: 64px; left: 0; right: 0; z-index: 9; height: 3px;
      background: var(--accent); transform-origin: 0 50%;
      animation: read-progress linear both; animation-timeline: scroll(root);
    }
    @keyframes read-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  }
  .end-mark { height: 1px; }
  @media (prefers-reduced-motion: reduce) {
    .stamp.fresh { animation: none; }
  }

  .demo-top { margin-top: 28px; }
  .prose { margin-top: 32px; font-family: var(--font-reading); font-size: 19px; line-height: 1.6; }
  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(h2) { margin: 1.8em 0 0.5em; font-family: var(--font-serif); font-weight: 400; font-size: 28px; line-height: 1.1; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1em; padding-left: 1.2em; }
  .prose :global(li) { margin-bottom: 0.5em; }
  .prose :global(strong) { font-weight: 500; }
  .prose :global(code) {
    font-family: var(--font-mono); font-size: 0.8em; padding: 1px 5px;
    border-radius: 4px; background: var(--rule);
  }

  /* Code blocks: a sheet of paper inside the page. Shiki uses its
     "css-variables" theme (astro.config.mjs), so the colours below come from
     the site palette and switch with light/dark mode:
     keywords in plum, strings in green, numbers in apricot, comments muted. */
  .prose {
    --astro-code-foreground: var(--ink);
    --astro-code-background: var(--card);
    --astro-code-token-keyword: var(--accent-text);
    --astro-code-token-string: var(--published-ink);
    --astro-code-token-string-expression: var(--published-ink);
    --astro-code-token-comment: var(--ink-muted);
    --astro-code-token-constant: var(--code-number);
    --astro-code-token-function: var(--ink);
    --astro-code-token-parameter: var(--ink-soft);
    --astro-code-token-punctuation: var(--ink-muted);
    --astro-code-token-link: var(--accent-text);
    --code-number: #9C4F2E;
  }
  :global(:root[data-theme="dark"]) .prose { --code-number: #EFBF93; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .prose { --code-number: #EFBF93; }
  }
  .prose :global(pre) {
    position: relative; margin: 1.2em 0 1.5em; padding: 36px 18px 16px;
    border: 1px solid var(--line); border-radius: 14px; box-shadow: 4px 4px 0 var(--rule);
    overflow-x: auto; font-size: 14px; line-height: 1.7; tab-size: 4;
  }
  /* The language, written small at the top of the sheet ("python", "bash"). */
  .prose :global(pre[data-language])::before {
    content: attr(data-language); position: absolute; top: 11px; left: 18px;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--ink-muted);
  }
  /* Inside a block, code drops the inline "chip" look (it was drawn line by line). */
  .prose :global(pre code) { padding: 0; border-radius: 0; background: none; font-size: inherit; }

  /* Tables: sans-serif, smaller than the reading text, a strong rule under the
     header and a fine line between rows, so each row reads as one line of a register. */
  .prose :global(table) {
    width: 100%; margin: 0.6em 0 1.6em; border-collapse: collapse;
    font-family: var(--font-sans); font-size: 15px; line-height: 1.45;
  }
  .prose :global(th) {
    padding: 8px 10px; border-bottom: 1.5px solid var(--ink); text-align: left; vertical-align: bottom;
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 500; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--ink-muted);
  }
  .prose :global(td) { padding: 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose :global(tbody tr:nth-child(even)) { background: var(--rule); }
  .prose :global(td code) { overflow-wrap: anywhere; }
  /* A bubble inside inline code keeps the code look; its card does not. */
  .prose :global(code .gloss-term) { font-size: inherit; }
  .prose :global(code .gloss-pop) { font-family: var(--font-sans); font-size: 17px; }
  .prose :global(blockquote) {
    margin: 0 0 1em; padding: 4px 0 4px 18px; border-left: 3px solid var(--accent-text);
    font-family: var(--font-serif); font-style: italic; font-size: 24px; line-height: 1.2;
  }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(a) { text-underline-offset: 3px; }

  /* Glossary bubbles (added by src/plugins/glossary-bubbles.ts).
     The word: same text, a dotted plum underline, a "?" cursor. */
  .prose :global(.gloss-term) {
    padding: 0; border: 0; background: none; font: inherit; color: inherit; cursor: help;
    text-decoration: underline dotted var(--accent-text); text-decoration-thickness: 1.5px; text-underline-offset: 4px;
  }
  .prose :global(.gloss-term:hover), .prose :global(.gloss-term:focus-visible) { color: var(--accent-text); }
  /* The bubble: a card that slides up from the bottom of the screen, over the
     text, so the reader keeps their place. Closes on tap outside, Escape or "Close". */
  .prose :global(.gloss-pop) {
    position: fixed; inset: auto 16px 16px; margin: 0 auto; max-width: 520px;
    padding: 16px 18px 8px; border: 1px solid var(--ink); border-radius: 16px;
    background: var(--card); color: var(--ink); box-shadow: 6px 6px 0 var(--shadow);
    font-family: var(--font-sans); font-size: 17px; line-height: 1.5;
  }
  .prose :global(.gloss-pop:popover-open) { display: flex; flex-direction: column; gap: 6px; animation: gloss-up .2s ease-out; }
  .prose :global(.gloss-name) { font-family: var(--font-serif); font-size: 24px; line-height: 1.1; }
  .prose :global(.gloss-def) { color: var(--ink-soft); }
  .prose :global(.gloss-actions) { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .prose :global(.gloss-link), .prose :global(.gloss-close) {
    display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 600;
  }
  .prose :global(.gloss-close) {
    padding: 0 4px; border: 0; background: none; color: var(--ink-muted); font-family: var(--font-mono);
    font-size: 13px; letter-spacing: 1px; text-transform: uppercase; cursor: pointer;
  }
  .prose :global(.gloss-pop::backdrop) { background: rgba(35, 26, 34, 0.15); }
  @keyframes gloss-up { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .prose :global(.gloss-pop:popover-open) { animation: none; }
  }

  .missing { margin-top: 32px; padding: 16px 18px; border: 1px dashed var(--accent-text); border-radius: 12px; font-size: 16px; }

  .end { margin-top: 40px; padding-top: 8px; border-top: 1px solid var(--line); }
  .block { margin-top: 20px; }
  .mono-label { margin: 0; font-family: var(--font-mono); font-size: 13px; letter-spacing: 2px; text-transform: uppercase; color: var(--ink-muted); }
  .mono { font-family: var(--font-mono); font-size: 13px; color: var(--ink-muted); }
  .applied {
    display: flex; flex-direction: column; gap: 2px; min-height: 44px; padding: 10px 0;
    border-bottom: 1px solid var(--rule); text-decoration: none;
  }
  .applied-title { font-family: var(--font-serif); font-size: 20px; line-height: 1.15; color: var(--ink); }
  .theme {
    margin: 10px 0 0; font-family: var(--font-mono); font-size: 13px; letter-spacing: 2px;
    text-transform: uppercase; color: var(--ink-muted);
  }
  .theme em { font-family: var(--font-serif); font-size: 22px; letter-spacing: 0; text-transform: none; }
  /* Stack: small chips, icon in plum next to the name. A partner technology
     gets a plum border and a mono note under its name. */
  .stack { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 0; padding: 0; list-style: none; }
  .tech {
    display: inline-flex; flex-wrap: wrap; align-items: center; column-gap: 8px; min-height: 40px; padding: 6px 14px;
    border: 1px solid var(--line); border-radius: 18px; background: var(--paper); font-size: 15px; line-height: 1.25;
  }
  .tech.partner { border-color: var(--accent-text); }
  .tech-icon { width: 18px; height: 18px; flex: none; color: var(--accent-text); }
  .tech-partner { flex-basis: 100%; padding-left: 26px; font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); }
  .links { display: flex; flex-wrap: wrap; column-gap: 24px; margin: 16px 0 0; }
  .code { display: inline-flex; align-items: center; min-height: 44px; font-size: 16px; font-weight: 600; }
  /* Previous / next: two cards, stacked on a phone, side by side from 640 px.
     The "next" card sits on the right and is aligned right, like turning a page. */
  .pager { display: grid; gap: 12px; }
  .pager-link, .pager-pending {
    display: flex; flex-direction: column; gap: 4px; margin: 0; padding: 14px 18px;
    border-radius: 14px; text-decoration: none; color: var(--ink);
  }
  .pager-link { background: var(--card); border: 1px solid var(--line); }
  .pager-link:hover { border-color: var(--accent-text); }
  .pager-pending { border: 1px dashed var(--ink-faint); }
  .next-title { font-family: var(--font-serif); font-size: 22px; line-height: 1.15; }
  .pager-pending .next-title { color: var(--ink-soft); }
  @media (min-width: 640px) {
    .pager { grid-template-columns: 1fr 1fr; }
    .to-next { grid-column: 2; text-align: right; }
  }
</style>

<script>
  // "Read" stamp. When the end of the text comes into view, the chapter is
  // remembered as read in this browser (localStorage), and the stamp appears.
  // localStorage can be missing or blocked (private mode): then nothing happens.
  const article = document.querySelector<HTMLElement>("[data-read-key]");
  const stamp = document.querySelector<HTMLElement>("[data-read-stamp]");
  const end = document.querySelector<HTMLElement>("[data-read-end]");
  const key = article ? `read:${article.dataset.readKey}` : null;

  const isRead = () => {
    try { return key !== null && localStorage.getItem(key) === "1"; } catch { return false; }
  };

  if (stamp && isRead()) stamp.hidden = false;

  if (key && stamp && end && !isRead() && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      try { localStorage.setItem(key, "1"); } catch { return; }
      stamp.hidden = false;
      stamp.classList.add("fresh");
      observer.disconnect();
    });
    observer.observe(end);
  }
</script>
