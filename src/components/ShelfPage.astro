---
import { getLocale, useTranslations, type UiKey } from "../i18n/ui";
import { books, shelfOrder, pad, type Shelf } from "../data/books";
import BookItem from "./BookItem.astro";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
// A book without a published chapter yet ("forthcoming") stays in books.ts but is
// not shown: an empty book on the shelf reads as an unfinished site. A rayon left
// with no book disappears too (filter below), and the rayon numbers stay continuous.
const groups = shelfOrder
  .map((shelf) => ({ shelf, books: books.filter((b) => b.shelf === shelf && !b.forthcoming) }))
  .filter((group) => group.books.length > 0);
// One sentence under a rayon's label, for a rayon with several books (a rayon with a
// single book shows that book's own description next to its cover instead).
const shelfLead: Partial<Record<Shelf, UiKey>> = {
  fundamentals: "shelf.lead.fundamentals",
  journeys: "shelf.lead.journeys",
};
const tags = [...new Set(books.flatMap((b) => b.tags ?? []))];
// Position of each book on the whole shelf, across rayons: it staggers the entry animation.
let position = 0;
const rows = groups.map((group) => ({ ...group, items: group.books.map((book) => ({ book, index: position++ })) }));
---

<section class="intro">
  <p class="kicker"><span class="dot" aria-hidden="true"></span>{t("shelf.kicker")}</p>
  <h1 set:html={t("shelf.title")} />
  <p class="lead">{t("shelf.intro")}</p>
  {tags.length > 0 && (
    <ul class="filters" aria-label={t("shelf.filters")}>
      <li><span class="chip active">{t("shelf.all")}</span></li>
      {tags.map((tag) => <li><span class="chip">{tag}</span></li>)}
    </ul>
  )}
</section>

{rows.map((group, i) => (
  <section class="rayon">
    <h2 class="rayon-label">
      <span>{t("shelf.rayon")} {pad(i + 1)} · <span class="rayon-name">{t(`shelf.${group.shelf}` as UiKey)}</span></span>
    </h2>
    {shelfLead[group.shelf] && <p class="rayon-lead">{t(shelfLead[group.shelf]!)}</p>}
    <div class="grid">
      {group.items.map(({ book, index }) => <BookItem book={book} index={index} solo={group.items.length === 1} />)}
    </div>
  </section>
))}

<style>
  .intro { padding: 36px 20px 8px; }
  .kicker {
    display: flex; align-items: center; gap: 10px; margin: 0;
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 2px; text-transform: uppercase; color: var(--ink-muted);
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--book-rose); }
  h1 { margin: 14px 0 0; font-family: var(--font-serif); font-weight: 400; font-size: 62px; line-height: 0.95; letter-spacing: -1.5px; }
  .lead { margin: 14px 0 0; font-size: 17px; line-height: 1.6; color: var(--ink-soft); }
  .filters { display: flex; gap: 8px; margin: 22px 0 0; padding: 0; list-style: none; }
  .chip {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px;
    border: 1px solid var(--line); border-radius: 999px; background: var(--card); font-size: 15px;
  }
  .chip.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .rayon { padding: 40px 20px 0; }
  /* Same size and colour as a book's description on the shelf (BookItem). */
  .rayon-lead { margin: -4px 0 18px; font-size: 15px; line-height: 1.55; color: var(--ink-soft); }
  .rayon-label {
    display: flex; align-items: center; gap: 10px; margin: 0 0 16px;
    font-family: var(--font-mono); font-weight: 400; font-size: 13px; letter-spacing: 2px;
    text-transform: uppercase; color: var(--ink-muted);
  }
  .rayon-label::after { content: ""; flex-grow: 1; height: 1px; background: var(--line); }
  .rayon-name { color: var(--ink); }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 18px; }
  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
